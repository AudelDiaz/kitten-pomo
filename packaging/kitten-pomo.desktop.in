[Desktop Entry]
Name=Pixel Kitten Pomodoro
Comment=Black kitten pomodoro — left start, double pause, right reset, middle kill (confirm)
Exec=@HOME@/.local/bin/kitten-pomo
Icon=@ICON@
Terminal=false
Type=Application
Categories=Utility;
Keywords=pomodoro;timer;kitten;cat;focus;
StartupWMClass=kitten-pomo
StartupNotify=false
NoDisplay=true

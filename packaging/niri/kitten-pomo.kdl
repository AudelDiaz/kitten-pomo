// Pixel Kitten Pomodoro — rule tested on Niri.
// Paste it into your rules file (e.g. cfg/rules.kdl).
// 200x200 window, bottom-right, no focus, 80% opacity.
window-rule {
    match app-id="kitten-pomo"
    open-floating true
    open-focused false
    opacity 0.8
    default-column-width { fixed 200; }
    default-window-height { fixed 200; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
}
